<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_request_line_view_list" model="ir.ui.view">
        <field name="name">purchase.request.line.list</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" multi_edit="0">
                <header>
                    <button name="action_create_purchase" type="object" string="Create Purchase"/>
                    <button name="action_send_from_stock" type="object" string="Send From Stock"/>
                    <button name="action_done" type="object" string="Close"/>
                </header>
                <field name="request_id"/>
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="product_id"/>
                <field name="picking_type_id" optional="show"/>
                <field name="quantity"/>
                <field name="uom_id" groups="uom.group_uom"/>
                <field name="price_unit"/>
                <field name="qty_purchased" optional="show"/>
                <field name="qty_from_stock" optional="show"/>
                <field name="qty_remaining"/>
                <field name="process_status" widget="badge" decoration-success="process_status == 'processed'" decoration-warning="process_status == 'partial'"/>
                <field name="state" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="purchase_request_line_view_search" model="ir.ui.view">
        <field name="name">purchase.request.line.search</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id"/>
                <field name="product_id"/>
                <field name="user_id"/>
                <filter name="not_processed" string="Not Fully Processed" domain="[('process_status', '!=', 'processed')]"/>
                <filter name="partial" string="Partially Processed" domain="[('process_status', '=', 'partial')]"/>
                <filter name="processed" string="Processed" domain="[('process_status', '=', 'processed')]"/>
                <group>
                    <filter name="group_request" string="Request" context="{'group_by': 'request_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_user" string="Requested By" context="{'group_by': 'user_id'}"/>
                    <filter name="group_picking_type" string="Deliver To" context="{'group_by': 'picking_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_request_line_to_process" model="ir.actions.act_window">
        <field name="name">To Process</field>
        <field name="res_model">purchase.request.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', '=', 'approved')]</field>
        <field name="context">{'search_default_not_processed': 1}</field>
        <field name="search_view_id" ref="purchase_request_line_view_search"/>
    </record>
</odoo>
