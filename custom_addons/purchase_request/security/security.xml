<odoo>
    <record id="res_groups_privilege_purchase_request" model="res.groups.privilege">
        <field name="name">Purchase Request</field>
        <field name="sequence">9</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_purchase_request_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_purchase_request"/>
    </record>

    <record id="group_purchase_request_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_purchase_request_user')), (4, ref('purchase.group_purchase_user')), (4, ref('stock.group_stock_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_purchase_request"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_purchase_request_manager'))]"/>
    </record>

</odoo>
